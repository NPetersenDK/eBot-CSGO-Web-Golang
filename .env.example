# Copy this file to .env and replace every change-me value.
# Each variable also accepts NAME_FILE=/path/to/file, which reads the value
# from a file (Docker and Kubernetes secrets). Do not set both.
# Blank values use the default from the table in README.md.

# --- HTTP and branding ---
HTTP_ADDR=:8080
EBOT_TITLE=eBot
EBOT_VERSION=

# --- Database (shared with the PHP panel) ---
# A full DSN. When set, the EBOT_DB_HOST, EBOT_DB_PORT, EBOT_DB_USER,
# EBOT_DB_PASSWORD and EBOT_DB_NAME values are not used.
EBOT_DB_DSN=
EBOT_DB_HOST=127.0.0.1
EBOT_DB_PORT=3306
EBOT_DB_NAME=ebotv3
EBOT_DB_USER=ebot
EBOT_DB_PASSWORD=change-me-32-chars-minimum

# --- Redis (shared with the bot) ---
EBOT_REDIS_ADDR=127.0.0.1:6379
EBOT_REDIS_USERNAME=
EBOT_REDIS_PASSWORD=
EBOT_REDIS_FROM_WS=ebot-from-ws
EBOT_REDIS_TO_WS=ebot-to-ws

# --- Sessions and local accounts ---
# At least 32 bytes. Create one with: openssl rand -base64 32
EBOT_SESSION_KEY=change-me-32-chars-minimum-replace-this-value
# Only for local development over plain HTTP. Makes the session key random.
EBOT_INSECURE_COOKIES=false
# Set to true only behind a proxy that appends to X-Forwarded-For. The login rate limit then keys on that address.
EBOT_TRUST_PROXY=false
# Creates this admin account on first start, when the users table is empty.
EBOT_ADMIN_USER=
EBOT_ADMIN_PASSWORD=
# true hides the password form. Needs EBOT_OIDC_ISSUER.
EBOT_LOCAL_LOGIN_DISABLED=false

# --- OIDC single sign-on (leave EBOT_OIDC_ISSUER empty to turn it off) ---
EBOT_OIDC_ISSUER=
EBOT_OIDC_CLIENT_ID=
EBOT_OIDC_CLIENT_SECRET=
# Full callback URL, for example https://ebot.example.org/auth/oidc/callback
EBOT_OIDC_REDIRECT_URL=
# Claim that lists the user's roles in the ID token or userinfo.
EBOT_OIDC_ROLES_CLAIM=roles
# claimValue=role pairs, comma separated. Example: ebot-admin=admin,ebot-viewer=viewer
EBOT_OIDC_ROLE_MAP=
# Role for users that match no role map entry. deny rejects them.
EBOT_OIDC_DEFAULT_ROLE=deny
# JSON list of extra login buttons. Example: [{"name":"Partner","hint":"Partner login","icon":""}]
EBOT_LOGIN_PROVIDERS=

# --- Demos and match logs (read-only in the panel) ---
EBOT_DEMO_PATH=/demos
EBOT_DEMO_DOWNLOAD=true
EBOT_LOG_MATCH_PATH=/logs/log_match
EBOT_LOG_MATCH_ADMIN_PATH=/logs/log_match_admin

# --- Match setup ---
# net shows the GOTV address, lan shows the server address.
EBOT_MODE=net
# Refresh interval in seconds.
EBOT_REFRESH_TIME=30
# Maps offered in the match form, comma separated.
EBOT_MAPS=de_dust2,de_mirage,de_inferno,de_nuke,de_ancient,de_anubis,de_overpass,de_vertigo
# Rule sets offered in the match form, comma separated.
EBOT_RULES=rules
EBOT_DEFAULT_MAX_ROUND=12
EBOT_DEFAULT_RULES=rules
EBOT_DEFAULT_OVERTIME_ENABLE=false
EBOT_DEFAULT_OVERTIME_MAX_ROUND=3
EBOT_DEFAULT_OVERTIME_START_MONEY=10000
# Default password for new matches. Leave empty for none.
EBOT_DEFAULT_PASSWORD=

# --- API ---
# Comma separated keys for the /api routes, sent in the X-API-Key header.
EBOT_API_KEYS=

# --- Logging ---
EBOT_LOG_LEVEL=info
EBOT_LOG_FORMAT=text

# --- Docker Compose only (deploy/docker-compose.yml) ---
# Root password of the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root
# Admin account of the legacy PHP panel (used when its schema is created).
EBOT_ADMIN_EMAIL=admin@localhost
# Image of the eBot-CSGO bot. Build it from ../eBot-CSGO first.
EBOT_BOT_IMAGE=ebot-csgo:latest
EBOT_BOT_PORT=12360
# Image of the legacy PHP panel (profile "legacy" only). Must serve HTTP on port 80.
EBOT_PHP_WEB_IMAGE=ebot-web-php:latest
EBOT_PHP_WEB_PORT=8081
# Host port of the Go panel.
EBOT_WEB_PORT=8080
# Host directories for demos and match logs, shared with the bot.
EBOT_DEMOS_DIR=./demos
EBOT_LOGS_DIR=./logs
